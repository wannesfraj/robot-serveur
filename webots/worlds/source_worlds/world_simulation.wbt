# ------------------------------------------------------------------
# Floor + perimeter walls (20m x 20m)
# ------------------------------------------------------------------
RectangleArena {
  floorSize 20 20
  floorTileSize 1 1
  floorAppearance PBRAppearance {
    baseColor 0.72 0.58 0.42
    roughness 0.85
    metalness 0
  }
  wallThickness 0.2
  wallHeight 2.6
  wallAppearance PBRAppearance {
    baseColor 0.92 0.88 0.8
    roughness 0.9
    metalness 0
  }
}

# ------------------------------------------------------------------
# SERVICE COUNTER (along the north wall, y ~ +9)
# ------------------------------------------------------------------
DEF COUNTER Solid {
  translation 0 9.3 0.5
  name "service_counter"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.35 0.22 0.14
        roughness 0.5
        metalness 0.1
      }
      geometry Box {
        size 14 0.7 1
      }
    }
    Transform {
      translation 0 0 0.51
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.15 0.15 0.16
            roughness 0.2
            metalness 0.6
          }
          geometry Box {
            size 14.05 0.75 0.03
          }
        }
      ]
    }
  ]
  boundingObject Box {
    size 14 0.7 1
  }
}

