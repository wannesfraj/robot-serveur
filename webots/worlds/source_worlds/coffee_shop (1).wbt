# ------------------------------------------------------------------
# PEDESTRIANS (2, walking back and forth along open aisles)
# ------------------------------------------------------------------
Pedestrian {
  translation -9 -9 1.27
  rotation 0 0 1 0
  name "customer_1"
  controllerArgs [
    "--trajectory=-9 -9, 9 -9"
    "--speed=0.6"
  ]
}

Pedestrian {
  translation 9 -9 1.27
  rotation 0 0 1 1.5708
  name "customer_2"
  controllerArgs [
    "--trajectory=9 -9, 9 9"
    "--speed=0.5"
  ]
}
