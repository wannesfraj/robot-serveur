#VRML_SIM R2025a utf8

# ------------------------------------------------------------------
# Coffee Shop ("Salon de café") environment - 20m x 20m
# 2 walking Pedestrians + counter, espresso machine, pastry display,
# cup shelving, cafe tables & chairs, potted plants, lighting.
# ------------------------------------------------------------------

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/tables/protos/Table.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/chairs/protos/WoodenChair.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/plants/protos/PottedTree.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/humans/pedestrian/protos/Pedestrian.proto"

WorldInfo {
  info [
    "A 20m x 20m coffee shop (salon de café) with a service counter, espresso machine, pastry display, cafe tables and 2 pedestrians walking around."
  ]
  title "Coffee Shop"
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      material1 "default"
      material2 "default"
      coulombFriction [
        0.6
      ]
    }
  ]
}

Viewpoint {
  orientation -0.15 0.12 0.98 1.15
  position -14 -16 14
  fieldOfView 0.9
}

Background {
  skyColor [
    0.6 0.7 0.85
  ]
  luminosity 1.2
}

DirectionalLight {
  direction -0.4 -0.6 -1
  intensity 1.6
  castShadows TRUE
}

PointLight {
  attenuation 0 0 1
  intensity 6
  location -5 3 3.5
  radius 12
}

PointLight {
  attenuation 0 0 1
  intensity 6
  location 5 3 3.5
  radius 12
}

PointLight {
  attenuation 0 0 1
  intensity 5
  location 0 8 3.2
  radius 10
}

# ------------------------------------------------------------------
# Floor + perimeter walls (20m x 20m)
# ------------------------------------------------------------------
RectangleArena {
  floorSize 20 20
  floorTileSize 1 1
  floorAppearance PBRAppearance {
    baseColor 0.72 0.58 0.42
    roughness 0.85
    metalness 0
  }
  wallThickness 0.2
  wallHeight 2.6
  wallAppearance PBRAppearance {
    baseColor 0.92 0.88 0.8
    roughness 0.9
    metalness 0
  }
}

# ------------------------------------------------------------------
# SERVICE COUNTER (along the north wall, y ~ +9)
# ------------------------------------------------------------------
DEF COUNTER Solid {
  translation 0 9.3 0.5
  name "service_counter"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.35 0.22 0.14
        roughness 0.5
        metalness 0.1
      }
      geometry Box {
        size 14 0.7 1
      }
    }
    Transform {
      translation 0 0 0.51
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.15 0.15 0.16
            roughness 0.2
            metalness 0.6
          }
          geometry Box {
            size 14.05 0.75 0.03
          }
        }
      ]
    }
  ]
  boundingObject Box {
    size 14 0.7 1
  }
}

# Espresso machine on the counter
DEF ESPRESSO_MACHINE Solid {
  translation 3 9.05 1.05
  name "espresso_machine"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.62 0.05 0.05
        roughness 0.3
        metalness 0.7
      }
      geometry Box {
        size 0.6 0.45 0.5
      }
    }
    Transform {
      translation -0.15 -0.24 -0.05
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.8 0.8 0.82
            roughness 0.2
            metalness 0.9
          }
          geometry Cylinder {
            height 0.28
            radius 0.045
          }
        }
      ]
    }
    Transform {
      translation 0.15 -0.24 -0.05
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.8 0.8 0.82
            roughness 0.2
            metalness 0.9
          }
          geometry Cylinder {
            height 0.28
            radius 0.045
          }
        }
      ]
    }
    Transform {
      translation 0 0.15 0.28
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.85 0.85 0.88
            roughness 0.15
            metalness 0.95
          }
          geometry Cylinder {
            height 0.12
            radius 0.16
          }
        }
      ]
    }
  ]
  boundingObject Box {
    size 0.6 0.45 0.6
  }
}

# Pastry / cake display case
DEF PASTRY_CASE Solid {
  translation -3 9.05 1.25
  name "pastry_display_case"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.7 0.85 0.9
        roughness 0.05
        metalness 0
        transparency 0.6
      }
      geometry Box {
        size 1 0.5 0.5
      }
    }
    Transform {
      translation 0 0 -0.2
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.2 0.2 0.2
            roughness 0.4
            metalness 0.4
          }
          geometry Box {
            size 1.02 0.52 0.06
          }
        }
      ]
    }
  ]
  boundingObject Box {
    size 1 0.5 0.5
  }
}

# Cash register
DEF CASH_REGISTER Solid {
  translation 0 9.05 1.1
  name "cash_register"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.1 0.1
        roughness 0.3
        metalness 0.3
      }
      geometry Box {
        size 0.35 0.3 0.18
      }
    }
  ]
  boundingObject Box {
    size 0.35 0.3 0.18
  }
}

# Shelving unit behind the counter, mounted on the wall, with cup stacks
DEF BACK_SHELF Solid {
  translation 0 9.85 1.7
  name "back_shelf"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.32 0.2 0.13
        roughness 0.6
        metalness 0.05
      }
      geometry Box {
        size 10 0.25 1.2
      }
    }
    Transform {
      translation -3 -0.2 0.35
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.95 0.95 0.95
            roughness 0.3
          }
          geometry Cylinder {
            height 0.12
            radius 0.05
          }
        }
      ]
    }
    Transform {
      translation -2.6 -0.2 0.35
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.95 0.95 0.95
            roughness 0.3
          }
          geometry Cylinder {
            height 0.12
            radius 0.05
          }
        }
      ]
    }
    Transform {
      translation -2.2 -0.2 0.35
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.95 0.95 0.95
            roughness 0.3
          }
          geometry Cylinder {
            height 0.12
            radius 0.05
          }
        }
      ]
    }
    Transform {
      translation 2.2 -0.2 -0.1
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.55 0.35 0.2
            roughness 0.5
          }
          geometry Box {
            size 1.4 0.2 0.15
          }
        }
      ]
    }
  ]
  boundingObject Box {
    size 10 0.25 1.2
  }
}

